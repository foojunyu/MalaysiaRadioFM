<Window x:Class="MalaysiaRadioFM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MalaysiaRadioFM"
        mc:Ignorable="d"
        Title="Malaysia Radio FM" Height="550" Width="700"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Section -->
        <Border Grid.Row="0" Background="#1E88E5" Padding="20">
            <StackPanel>
                <TextBlock Text="Malaysia Radio FM" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Listen to your favorite Malaysian radio stations" 
                          FontSize="14" 
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Station List -->
        <Border Grid.Row="1" Margin="20,20,20,10" 
                Background="White"
                BorderBrush="#CCCCCC" 
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                          Text="Select a Radio Station:" 
                          FontSize="16" 
                          FontWeight="SemiBold"
                          Margin="10,10,10,5"/>
                
                <ListBox Grid.Row="1" 
                        x:Name="StationListBox"
                        SelectionChanged="StationListBox_SelectionChanged"
                        Margin="10,5,10,10"
                        FontSize="14">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Name}" 
                                          FontWeight="SemiBold"
                                          FontSize="14"/>
                                <TextBlock Text="{Binding Description}" 
                                          FontSize="12"
                                          Foreground="Gray"
                                          TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Control Panel -->
        <Border Grid.Row="2" Margin="20,0,20,10" 
                Background="White"
                BorderBrush="#CCCCCC" 
                BorderThickness="1"
                CornerRadius="5"
                Padding="15">
            <StackPanel>
                <!-- Playback Controls -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10">
                    <Button x:Name="PlayButton" 
                           Content="▶ Play" 
                           Width="100"
                           Click="PlayButton_Click"
                           Background="#4CAF50"
                           Foreground="White"
                           FontWeight="Bold"/>
                    <Button x:Name="StopButton" 
                           Content="⏹ Stop" 
                           Width="100"
                           Click="StopButton_Click"
                           Background="#F44336"
                           Foreground="White"
                           FontWeight="Bold"/>
                </StackPanel>

                <!-- Volume Control -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center">
                    <TextBlock Text="🔊 Volume:" 
                              VerticalAlignment="Center"
                              FontSize="14"
                              Margin="0,0,10,0"/>
                    <Slider x:Name="VolumeSlider"
                           Width="200"
                           Minimum="0"
                           Maximum="100"
                           Value="50"
                           VerticalAlignment="Center"
                           ValueChanged="VolumeSlider_ValueChanged"
                           TickFrequency="10"
                           IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="VolumeLabel"
                              Text="50%"
                              VerticalAlignment="Center"
                              Width="40"
                              FontSize="14"
                              Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#263238" Padding="10,8">
            <TextBlock x:Name="StatusLabel" 
                      Text="Ready" 
                      Foreground="White"
                      FontSize="12"/>
        </Border>
    </Grid>
</Window>
